generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Verify {
  VERIFIED
  NOTVERIFIED
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  username      String         @unique
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          Role
  verify        Verify         @default(NOTVERIFIED)
  address       UserAddress?
  orders        Order[]
  shoppingCart  ShoppingCart?
  comments      Comment[]
  replies       Reply[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UserAddress {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  user       User       @relation(fields: [userId], references: [id])
  userId     String     @unique @db.ObjectId
  address1   String
  address2   String?
  city       String
  state      String
  country    String
  postalCode String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Product {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  description       String
  price             Float
  sku               String
  category          ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId        String          @db.ObjectId
  subcategory       Subcategory     @relation(fields: [subcategoryId], references: [id])
  subcategoryId     String          @db.ObjectId
  inventory         ProductInventory @relation(fields: [inventoryId], references: [id])
  inventoryId       String          @db.ObjectId
  discount          Discount?       @relation(fields: [discountId], references: [id])
  discountId        String?         @db.ObjectId
  orderItems        OrderItem[]
  cartItems         CartItem[]
  images            ProductImage[]
  comments          Comment[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ProductCategory {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  parent          ProductCategory?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId        String? @db.ObjectId
  subcategories   ProductCategory[] @relation("CategoryToSubcategory")
  subSubcategories Subcategory[]    @relation("ProductCategoryToSubcategory")
  products        Product[]
  image           CategoryImage?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Subcategory {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  parentCategory ProductCategory   @relation("ProductCategoryToSubcategory", fields: [parentCategoryId], references: [id])
  parentCategoryId String          @db.ObjectId
  products       Product[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model ProductImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryImage {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  category  ProductCategory   @relation(fields: [categoryId], references: [id])
  categoryId String           @unique @db.ObjectId
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ProductInventory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discount {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  discountPercent Float
  active        Boolean   @default(true)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  user       User          @relation(fields: [userId], references: [id])
  userId     String @db.ObjectId
  total      Float
  items      OrderItem[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String @db.ObjectId
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShoppingCart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  userId    String @unique @db.ObjectId
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  cart      ShoppingCart @relation(fields: [cartId], references: [id])
  cartId    String @db.ObjectId
  product   Product    @relation(fields: [productId], references: [id])
  productId String @db.ObjectId
  quantity  Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Comment {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  product   Product    @relation(fields: [productId], references: [id])
  productId String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  userId    String     @db.ObjectId
  replies   Reply[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Reply {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  comment   Comment    @relation(fields: [commentId], references: [id])
  commentId String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  userId    String     @db.ObjectId
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  user      User       @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}